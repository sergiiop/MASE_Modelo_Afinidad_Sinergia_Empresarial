# Etapa de construcción
FROM python:3.12-slim as builder

WORKDIR /app

# Variables esenciales para build
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/opt/venv/bin:$PATH"

# Instalar dependencias de sistema necesarias para build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-client \
    libpq-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Crear y activar entorno virtual
RUN python -m venv /opt/venv

# Instalar dependencias
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Etapa de producción
FROM python:3.12-slim

WORKDIR /app

# Copiar solo el entorno virtual
COPY --from=builder /opt/venv /opt/venv

# Variables esenciales para runtime
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Instalar cliente PostgreSQL para healthchecks
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-client \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

# Copiar código y crear estructura
COPY . .
RUN mkdir -p /app/data

# Configurar usuario no root
RUN useradd -m appuser && \
    chown -R appuser:appuser /app
USER appuser

# Puerto por defecto (puede ser sobreescrito en runtime)
EXPOSE 8000

# Comando para ejecutar la aplicación
CMD ["uvicorn", "app.main:app", \
     "--host", "0.0.0.0", \
     "--port", "8000", \
     "--workers", "4"]
