# Configuración general
MASE_APP_NAME="MASE API"
MASE_APP_VERSION="1.0.0"
MASE_ENVIRONMENT=development
MASE_DEBUG=true

# Configuración de la API
MASE_API_PREFIX=/api/v1
MASE_HOST=0.0.0.0
MASE_PORT=8000
MASE_WORKERS=1

# Configuración de base de datos
MASE_DB_PATH=/app/data/sector_matrix.db

# PostgreSQL
MASE_POSTGRES_SERVER=postgres
MASE_POSTGRES_PORT=5432
MASE_POSTGRES_USER=postgres
MASE_POSTGRES_PASSWORD=postgres_password
MASE_POSTGRES_DB=mase

# Configuración de archivos
MASE_DATA_DIR=/app/data
MASE_EXCEL_MATRIZ_PATH=/app/matriz.xlsx

# Configuración de CORS
MASE_CORS_ORIGINS=*
MASE_CORS_METHODS=*
MASE_CORS_HEADERS=*

# Límite de resultados por defecto
MASE_DEFAULT_LIMIT=100

# Configuración de logging
MASE_LOG_LEVEL=INFO
