FROM python:3.9-slim

WORKDIR /app

# Configurar variables de entorno por defecto
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    MASE_ENVIRONMENT=development \
    MASE_DEBUG=true \
    MASE_PORT=8000 \
    MASE_HOST=0.0.0.0 \
    MASE_DB_PATH=/app/data/sector_matrix.db \
    MASE_DATA_DIR=/app/data \
    MASE_LOG_LEVEL=DEBUG

# Instalar dependencias de sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copiar archivos de requisitos primero para aprovechar la caché de Docker
COPY requirements.txt /app/requirements.txt

# Instalar dependencias
RUN pip install --no-cache-dir -r /app/requirements.txt && \
    # Asegurarse de que pydantic-settings esté instalado
    pip install --no-cache-dir pydantic-settings

# Copiar el código fuente
COPY . .

# Crear directorio para datos
RUN mkdir -p /app/data

# Exponer el puerto
EXPOSE 8000

# Copiar y hacer ejecutable el script de inicio
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh && \
    # Asegurarse de que el script tenga formato UNIX (LF en lugar de CRLF)
    sed -i 's/\r$//' /app/start.sh

# Comando para ejecutar la aplicación
CMD ["bash", "/app/start.sh"]
